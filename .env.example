# 测试环境配置（复制此文件为 .env 后修改）
ENV=test
DEBUG=true

# Milvus 连接地址
MILVUS_URI=http://localhost:19530

# MySQL 数据库配置
DATABASE_URL=mysql+aiomysql://root:123456@localhost:3306/Food_Assistant_Test

# DeepSeek API 配置
# 获取 API Key: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 硅基流动 API 配置（用于嵌入模型）
# 获取 API Key: https://siliconflow.cn/
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# 高德地图 API 配置（用于 IP 定位和天气查询，注册地址：https://lbs.amap.com/）
# 注意：必须使用"Web服务"类型的API Key，"Web端(JS API)"类型不支持IP定位
AMAP_API_KEY=your_amap_key
